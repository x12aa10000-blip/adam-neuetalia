# Vorlage – NIEMALS echte Werte in diese Datei schreiben und nie committen.
# Echte Werte setzt man NUR als Supabase-Secrets (Dashboard -> Edge Functions -> Secrets
# oder: supabase secrets set NAME=wert). Sie stehen nie im Browser-Code.

# Wird von Supabase automatisch bereitgestellt (nicht selbst setzen):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (geheim, nur serverseitig)

# PayPal (zuerst Sandbox, dann Live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# DHL Versand
DHL_API_KEY=

# Hinweis: Im Browser (js/config.js) steht nur der öffentliche "publishable" Key.
