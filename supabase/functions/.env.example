# Edge Function secrets – set them with:  supabase secrets set --env-file supabase/functions/.env   (never commit the real file)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
PAYPAL_ENV=sandbox            # sandbox while testing, live for real payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # from developer.paypal.com → your app → Webhooks
ALLOWED_ORIGINS=https://www.example-shop.de,https://example-shop.de
